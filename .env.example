# Dev.to Configuration
DEVTO_USERNAME=your_devto_username

# API Keys
DEVTO_API_KEY="your_api_key_here"

# GitHub Configuration
PAT_1=ghp_your_token_here              # Primary Personal Access Token
GITHUB_STATS_TOKEN=ghp_your_token_here # Fallback token name

# Fork Configuration (Optional)
# If you use a dedicated organization to store your forks
FORK_ORG_NAME=

# ---------------------------------------------------------------------------
# Article Selection — URL-based (takes priority over index below)
# ---------------------------------------------------------------------------
# Paste the exact Dev.to article URL to pin a specific post.
# When set, the corresponding *_ARTICLE_INDEX variable is ignored.
# Leave blank to fall back to index-based selection.
#
PINNED_ARTICLE_URL=                     # e.g. https://dev.to/youruser/my-article-slug
CARD3_ARTICLE_URL=                      # e.g. https://dev.to/youruser/another-article-slug

# ---------------------------------------------------------------------------
# Article Selection — Index-based fallback
# All indices are 1-based (1 = most recent article, 2 = second most recent, etc.)
# Used only when the corresponding *_URL variable above is empty.
# ---------------------------------------------------------------------------
CARD1_ARTICLE_INDEX=1                  # Left Card
CARD3_ARTICLE_INDEX=2                  # Right Card

# Per-Card Reaction Display (true/false)
CARD1_SHOW_REACTIONS=true              # Show ❤️ count on left card
CARD2_SHOW_REACTIONS=true              # Show ❤️ count on middle (pinned) card
CARD3_SHOW_REACTIONS=true              # Show ❤️ count on right card

# Pinned Article Configuration (Middle Card)
PINNED_ARTICLE_INDEX=3                 # Middle Card index fallback (used when PINNED_ARTICLE_URL is empty)
PINNED_SHOW_COVER=true                 # Show cover image on pinned card
PINNED_SHOW_TAGS=true                  # Show tags on pinned card
PINNED_SHOW_READ_TIME=true             # Show read time on pinned card
PINNED_SHOW_COMMENTS=false             # Show/hide comment count
