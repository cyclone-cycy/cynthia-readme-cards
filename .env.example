# Dev.to Configuration
DEVTO_USERNAME=your_devto_username

# API Keys
DEVTO_API_KEY="your_api_key_here"

# GitHub Configuration
PAT_1=ghp_your_token_here              # Primary Personal Access Token
GITHUB_STATS_TOKEN=ghp_your_token_here # Fallback token name

# Fork Configuration (Optional)
FORK_ORG_NAME=

# ---------------------------------------------------------------------------
# Card Layout (fixed — 3 cards in the Articles section):
#
#   Card 1 (left)    → always the most recent article. No config needed.
#   Pinned (middle)  → locked to a specific article via PINNED_ARTICLE_URL.
#   Card 3 (right)   → locked to a specific article via CARD3_ARTICLE_URL.
#
# Set the exact Dev.to article URL for the pinned and card 3 slots.
# If a URL var is left blank, the card falls back to the index shown below.
# ---------------------------------------------------------------------------

# Middle card — paste the Dev.to article URL you want pinned here
PINNED_ARTICLE_URL=                     # e.g. https://dev.to/youruser/article-slug

# Right card — paste the Dev.to article URL you want here
CARD3_ARTICLE_URL=                      # e.g. https://dev.to/youruser/another-article-slug

# Pinned article index fallback (used only when PINNED_ARTICLE_URL is blank)
PINNED_ARTICLE_INDEX=1

# Per-Card Reaction Display (true/false)
CARD1_SHOW_REACTIONS=true
CARD2_SHOW_REACTIONS=true
CARD3_SHOW_REACTIONS=true

# ---------------------------------------------------------------------------
# Daily Tip — "Scar Tissue" card
# ---------------------------------------------------------------------------
# Raw URL to a (secret) GitHub Gist containing tips.json.
# Edit the gist from your phone anytime — no deploy needed.
# Falls back to local tips.json if blank or unreachable.
TIPS_GIST_URL=
